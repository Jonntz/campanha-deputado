
# Turso — o painel recebe um token read-write; o site, um somente-leitura:
#   turso db tokens create <db> --read-only
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Segredo compartilhado com o painel para disparar a revalidação do site.
REVALIDATE_SECRET=

# Painel — o BETTER_AUTH_URL define a origem confiável e o escopo do cookie.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
