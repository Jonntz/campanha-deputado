
# Turso — o painel recebe um token read-write; o site, um somente-leitura:
#   turso db tokens create <db> --read-only
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Segredo compartilhado com o painel para disparar a revalidação do site.
REVALIDATE_SECRET=

# Painel — o BETTER_AUTH_URL define a origem confiável e o escopo do cookie.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# Armazenamento das mídias em produção. Sem isto, o painel grava em
# apps/site/public/uploads/ — só serve para desenvolvimento.
BLOB_READ_WRITE_TOKEN=

# Painel: origem das mídias com caminho relativo (/images, /assets…). Sem valor,
# usa SITE_URL. Localmente, http://localhost:3000 mostra arquivos que ainda não
# subiram para o site publicado.
MEDIA_ORIGIN=

# Site, só local: "draft" exibe os RASCUNHOS em vez do conteúdo publicado, para
# conferir textos sem publicar. Não tem efeito na Vercel.
CONTENT_SOURCE=
