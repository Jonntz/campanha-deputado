# Copie para .env.local (desenvolvimento) ou configure na hospedagem (produção).
# São IDs públicos: ficam visíveis no HTML e não são segredo.

# Tag do Google / Google Analytics 4 — formato G-XXXXXXXXXX
# Já tem um padrão no código; defina aqui para usar outra conta.
NEXT_PUBLIC_GOOGLE_TAG_ID=G-JXEBVJVR0M

# Pixel da Meta (Facebook/Instagram Ads) — apenas os dígitos do ID,
# encontrado em Gerenciador de Eventos > Fontes de dados.
# Sem este valor, o pixel simplesmente não é carregado.
NEXT_PUBLIC_META_PIXEL_ID=
