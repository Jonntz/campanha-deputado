{
  "name": "campanha-matheus-biancardine",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter site dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:push": "pnpm --filter @campanha/db db:push",
    "db:seed": "pnpm --filter @campanha/db db:seed",
    "db:verify": "pnpm --filter @campanha/db db:verify",
    "media:generate": "node packages/content/scripts/generate-media.mjs"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
